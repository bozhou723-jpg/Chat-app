381| <script>
382|   // State
383|   let messages = [];
384|   let pendingImages = [];
385|   const EMOJIS = ['😊','😂','🥺','😳','😌','🌝','🌚','🤭','^^','💋','❤️','💕','♡','🥀','😘','😍','🤔','😤','😭','😴','🙈','🤏','👀','🖕','💪','👈','👉','✨','🔥','💀'];
386| 
387|   // Init
388|   function init() {
389|     const saved = localStorage.getItem('chat-settings');
390|     if (saved) {
391|       const s = JSON.parse(saved);
392|       document.getElementById('apiKeyInput').value = s.apiKey || '';
393|       document.getElementById('modelInput').value = s.model || 'claude-sonnet-4-20250514';
394|       document.getElementById('systemPromptInput').value = s.systemPrompt || '';
395|     }
396|     renderEmojis();
397|     document.getElementById('msgInput').addEventListener('input', () => {
398|       document.getElementById('sendBtn').disabled = !document.getElementById('msgInput').value.trim() && pendingImages.length === 0;
399|     });
400|   }
401| 
402|   // Emoji
403|   function renderEmojis() {
404|     const picker = document.getElementById('emojiPicker');
405|     picker.innerHTML = EMOJIS.map(e => `<button onclick="insertEmoji('${e}')">${e}</button>`).join('');
406|   }
407|   function toggleEmoji() {
408|     document.getElementById('emojiPicker').classList.toggle('active');
409|   }
410|   function insertEmoji(e) {
411|     const input = document.getElementById('msgInput');
412|     input.value += e;
413|     input.focus();
414|     document.getElementById('sendBtn').disabled = false;
415|     document.getElementById('emojiPicker').classList.remove('active');
416|   }
417| 
418|   // File upload
419|   function triggerUpload() { document.getElementById('fileInput').click(); }
420|   function handleFiles(e) {
421|     const files = Array.from(e.target.files);
422|     files.forEach(file => {
423|       if (file.type.startsWith('image/')) {
424|         const reader = new FileReader();
425|         reader.onload = (ev) => {
426|           pendingImages.push({ name: file.name, data: ev.target.result, type: file.type });
427|           renderPreviews();
428|           document.getElementById('sendBtn').disabled = false;
429|         };
430|         reader.readAsDataURL(file);
431|       }
432|     });
433|     e.target.value = '';
434|   }
435|   function renderPreviews() {
436|     const area = document.getElementById('previewArea');
437|     if (pendingImages.length === 0) { area.classList.remove('active'); area.innerHTML = ''; return; }
438|     area.classList.add('active');
439|     area.innerHTML = pendingImages.map((img, i) =>
440|       `<div class="preview-item"><img src="${img.data}"><button class="remove-btn" onclick="removePreview(${i})">×</button></div>`
441|     ).join('');
442|   }
443|   function removePreview(i) {
444|     pendingImages.splice(i, 1);
445|     renderPreviews();
446|     if (!document.getElementById('msgInput').value.trim() && pendingImages.length === 0) {
447|       document.getElementById('sendBtn').disabled = true;
448|     }
449|   }
450| 
451|   // Settings
452|   function openSettings() { document.getElementById('settingsModal').classList.add('active'); }
453|   function closeSettings() { document.getElementById('settingsModal').classList.remove('active'); }
454|   function saveSettings() {
455|     const settings = {
456|       apiKey: document.getElementById('apiKeyInput').value.trim(),
457|       model: document.getElementById('modelInput').value.trim(),
458|       systemPrompt: document.getElementById('systemPromptInput').value.trim()
459|     };
460|     localStorage.setItem('chat-settings', JSON.stringify(settings));
461|     closeSettings();
462|   }
463| 
464|   // Time
465|   function getTime() {
466|     const now = new Date();
467|     return now.getHours().toString().padStart(2,'0') + ':' + now.getMinutes().toString().padStart(2,'0');
468|   }
469| 
470|   // Render message
471|   function addMessage(role, text, images = []) {
472|     const container = document.getElementById('chatContainer');
473|     const isUser = role === 'user';
474|     const row = document.createElement('div');
475|     row.className = `msg-row ${isUser ? 'user' : 'ai'}`;
476| 
477|     let imagesHtml = images.map(img => `<img class="msg-image" src="${img.data}" alt="${img.name}">`).join('');
478| 
479|     row.innerHTML = `
480|       <div class="msg-avatar">${isUser ? '佳' : '言'}</div>
481|       <div>
482|         <div class="msg-bubble">${escapeHtml(text)}${imagesHtml}</div>
483|         <div class="msg-time">${getTime()}</div>
484|       </div>
485|     `;
486|     container.appendChild(row);
487|     container.scrollTop = container.scrollHeight;
488|     return row;
489|   }
490| 
491|   function escapeHtml(text) {
492|     const d = document.createElement('div');
493|     d.textContent = text;
494|     return d.innerHTML;
495|   }
496| 
497|   // Auto resize textarea
498|   function autoResize(el) {
499|     el.style.height = 'auto';
500|     el.style.height = Math.min(el.scrollHeight, 120) + 'px';
501|   }
502| 
503|   // Key handler
504|   function handleKey(e) {
505|     if (e.key === 'Enter' && !e.shiftKey) {
506|       e.preventDefault();
507|       sendMessage();
508|     }
509|   }
510| 
511|   // Send
512|   async function sendMessage() {
513|     const input = document.getElementById('msgInput');
514|     const text = input.value.trim();
515|     if (!text && pendingImages.length === 0) return;
516| 
517|     const images = [...pendingImages];
518|     pendingImages = [];
519|     renderPreviews();
520| 
521|     // Show user message
522|     addMessage('user', text, images);
523|     input.value = '';
524|     input.style.height = 'auto';
525|     document.getElementById('sendBtn').disabled = true;
526| 
527|     // Build API message content
528|     let content = [];
529|     images.forEach(img => {
530|       const base64 = img.data.split(',')[1];
531|       content.push({
532|         type: 'image',
533|         source: { type: 'base64', media_type: img.type, data: base64 }
534|       });
535|     });
536|     if (text) content.push({ type: 'text', text });
537| 
538|     messages.push({ role: 'user', content: content.length === 1 && content[0].type === 'text' ? text : content });
539| 
540|     // Call API
541|     const saved = JSON.parse(localStorage.getItem('chat-settings') || '{}');
542|     if (!saved.apiKey) {
543|       addMessage('assistant', '请先在设置中填写 API Key ⚙');
544|       return;
545|     }
546| 
547|     // Show typing
548|     const typing = document.getElementById('typingIndicator');
549|     typing.classList.add('active');
550|     document.getElementById('chatContainer').scrollTop = document.getElementById('chatContainer').scrollHeight;
551| 
552|     try {
553|       const resp = await fetch('https://api.anthropic.com/v1/messages', {
554|         method: 'POST',
555|         headers: {
556|           'Content-Type': 'application/json',
557|           'x-api-key': saved.apiKey,
558|           'anthropic-version': '2023-06-01',
559|           'anthropic-dangerous-direct-browser-access': 'true'
560|         },
561|         body: JSON.stringify({
562|           model: saved.model || 'claude-sonnet-4-20250514',
563|           max_tokens: 1024,
564|           system: saved.systemPrompt || '',
565|           messages: messages
566|         })
567|       });
568| 
569|       typing.classList.remove('active');
570| 
571|       if (!resp.ok) {
572|         const err = await resp.text();
573|         addMessage('assistant', `请求失败: ${resp.status}`);
574|         return;
575|       }
576| 
577|       const data = await resp.json();
578|       const reply = data.content.map(c => c.text || '').join('');
579|       addMessage('assistant', reply);
580|       messages.push({ role: 'assistant', content: reply });
581| 
582|     } catch (e) {
583|       typing.classList.remove('active');
584|       addMessage('assistant', `网络错误: ${e.message}`);
585|     }
586|   }
